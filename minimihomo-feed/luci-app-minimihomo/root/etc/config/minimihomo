config global 'global'
	option enabled '0'
	option mode 'rule'
	option tun '1'
	option ipv6 '0'
	option log_level 'info'
	option log_lines '200'
	option system_log '0'
	option controller_port '9090'
	option secret ''
	option config_source 'generated'
	option auto_start '1'

config dns 'dns'
	option enabled '1'
	option mode 'fake-ip'
	option listen_port '1053'
	list domestic '223.5.5.5'
	list domestic '223.6.6.6'
	list foreign 'https://1.1.1.1/dns-query'
	list foreign 'https://8.8.8.8/dns-query'
	list fakeip_filter '*.lan'
	list fakeip_filter '*.local'
	list fakeip_filter 'localhost'

config routing 'routing'
	option china 'DIRECT'
	option default_policy 'Proxy'
	option google 'Proxy'
	option youtube 'Proxy'
	option github 'Proxy'
	option openai 'Proxy'
	option telegram 'Proxy'
	option netflix 'Proxy'
	option microsoft 'DIRECT'
	option apple 'DIRECT'
	option tiktok 'Proxy'
	option disney 'Proxy'
	option spotify 'Proxy'
	option steam 'Proxy'
	option bilibili 'DIRECT'
	option hk 'HK'
	option tw 'TW'
	option jp 'JP'
	option sg 'SG'
	option kr 'KR'
	option us 'US'
	option other 'Proxy'
	list custom_rule 'DOMAIN-SUFFIX,example.com,DIRECT'

config proxy 'http'
	option enabled '1'
	option port '7890'
config proxy 'socks'
	option enabled '1'
	option port '7891'
config proxy 'mixed'
	option enabled '0'
	option port '7892'
