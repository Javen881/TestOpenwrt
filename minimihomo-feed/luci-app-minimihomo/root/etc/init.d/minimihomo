#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1
CONFIG=/etc/minimihomo/runtime.yaml
LOG=/tmp/minimihomo.log
LOG_LINES=200
SYSTEM_LOG=0

log() {
	printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$LOG"
	tail -n "$LOG_LINES" "$LOG" > "$LOG.new" && mv "$LOG.new" "$LOG"
	[ "$SYSTEM_LOG" = 1 ] && logger -t minimihomo -- "$*"
}

start_service() {
	umask 077
	mkdir -p /tmp
	: > "$LOG"
	log 'Starting MiniMihomo'
	config_load minimihomo
	config_get enabled global enabled 0
	config_get LOG_LINES global log_lines 200
	config_get SYSTEM_LOG global system_log 0
	case "$LOG_LINES" in ''|*[!0-9]*) LOG_LINES=200;; esac
	if [ "$enabled" != 1 ]; then
		log 'Service is disabled in /etc/config/minimihomo'
		return 0
	fi
	config_get source global config_source generated
	if [ "$source" = custom ]; then
		CONFIG=/etc/minimihomo/runtime.yaml
		if [ ! -s "$CONFIG" ]; then
			log 'No validated custom runtime configuration; import and apply it first'
			return 1
		fi
	elif ! /usr/libexec/minimihomo/generate >> "$LOG" 2>&1; then
		log 'Configuration generation failed; see preceding output'
		return 1
	fi
	[ -s "$CONFIG" ] || { log 'Configuration is missing or empty'; return 1; }
	log 'Launching Mihomo without pre-validation'
	procd_open_instance
	procd_set_param command /usr/bin/mihomo -d /etc/minimihomo -f "$CONFIG"
	procd_set_param respawn 3600 5 5
	[ "$SYSTEM_LOG" = 1 ] && procd_set_param stdout 1
	[ "$SYSTEM_LOG" = 1 ] && procd_set_param stderr 1
	procd_set_param file "$CONFIG"
	procd_close_instance
}

reload_service() {
	# Reload may be invoked before procd has an instance.  Continue to start
	# in that case instead of treating the missing instance as a hard error.
	stop >/dev/null 2>&1 || true
	start
}
service_triggers() { procd_add_reload_trigger minimihomo; }
